# VectorShift Pipeline Builder — backend environment variables
# Copy this file to ".env" in the backend folder and add your own API keys,
# then restart the backend server.

# OpenAI — used when LLM node model is "gpt-4o-mini"
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — used when LLM node model is "gemini-2.0-flash"
# Get yours at: https://aistudio.google.com/app/apikey
# New keys start with AQ. (auth keys) — older keys start with AIza. Both are valid.
GOOGLE_API_KEY=
